[Unit]
Description=Hermes Agent Gateway - Messaging Platform Integration
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/home/pyrr/.hermes/hermes-agent/venv/bin/python -m hermes_cli.main gateway run
WorkingDirectory=/home/pyrr/.hermes
Environment="PATH=/home/pyrr/.hermes/hermes-agent/venv/bin:/home/pyrr/.hermes/hermes-agent/node_modules/.bin:/home/pyrr/.local/share/mise/installs/node/latest/bin:/home/pyrr/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="VIRTUAL_ENV=/home/pyrr/.hermes/hermes-agent/venv"
Environment="HERMES_HOME=/home/pyrr/.hermes"
Environment="HERMES_SUPERVISED_CHILD=1"
Restart=always
RestartSec=5
RestartForceExitStatus=75
SuccessExitStatus=75
RestartPreventExitStatus=78
KillMode=mixed
KillSignal=SIGTERM
ExecReload=/bin/kill -USR1 $MAINPID
ExecStop=-/home/pyrr/.hermes/hermes-agent/venv/bin/python -m gateway.systemd_stop_mark
ExecStopPost=-/home/pyrr/.hermes/hermes-agent/venv/bin/python -m gateway.cgroup_cleanup
TimeoutStopSec=70
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
