[Unit]
Description=Update the Pi coding agent usage record for Omarchy
Documentation=man:omarchy-agent-usage-update(1)

[Service]
Type=oneshot
Environment=PI_CODING_AGENT_DIR=%h/.pi/agent
Environment=XDG_STATE_HOME=%h/.local/state
Environment=XDG_CACHE_HOME=%h/.cache
ExecStart=%h/.local/bin/omarchy-agent-usage-pi --output %h/.local/state/omarchy/agents/usage/pi.json

[Install]
WantedBy=multi-user.target
